# Copy to .env.api for the server only; never commit this file or real secrets.
API_PORT=4001
API_HOST=127.0.0.1
API_DB_PATH=./server/data/api.sqlite
WEB_ORIGINS=http://localhost:5173
RFQ_LIMIT_PER_15M=10
TRACK_LOOKUP_LIMIT_PER_15M=60

# Sync is off until you set a random secret of at least 32 characters.
SYNC_NODE_ID=mobile-local
SYNC_SHARED_SECRET=
# Example local peers; use HTTPS for any non-loopback network.
SYNC_PEERS=web-local=http://127.0.0.1:4000,desktop-local=http://127.0.0.1:4002

# Supabase Auth (backend only). Admin IDs are verified provider user IDs, not emails.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_USER_IDS=

# Required for protected supply-chain APIs: the one configured enterprise ID in SQLite.
# Set only after creating the enterprise row and assigning explicit roles in enterprise_role_assignments.
SINGLE_ENTERPRISE_ID=

# Expo client variables are public identifiers only; never place service-role keys here.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
