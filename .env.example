# Expo client configuration. EXPO_PUBLIC_* values are embedded in the client bundle.
# Leave EXPO_PUBLIC_API_URL unset to use platform defaults:
# - Android Emulator: http://10.0.2.2:4001
# - iOS Simulator: http://127.0.0.1:4001
# For a physical device, uncomment and replace with the computer's reachable LAN URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4001

# Do not add backend secrets, service-role keys, or private signing keys to this file.
# Supabase client variables belong here only if the app actually initializes a client-side Supabase SDK.
